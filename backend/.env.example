# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER commit the real .env file.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (MySQL) ----
# Set DB_ENGINE=sqlite for a quick try-out without MySQL.
DB_ENGINE=mysql
DB_NAME=chatdoc_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- CORS (React dev server) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---- LLM (any OpenAI-compatible API) ----
LLM_API_KEY=your-api-key-here
# Leave LLM_BASE_URL empty for OpenAI. Examples:
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1   (use any text as the key)
LLM_API_KEY=gsk_paste_your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# ---- RAG settings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# ---- Limits ----
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300
THROTTLE_ASK=30/min
